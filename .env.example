# Copie para .env.local (local) ou cadastre no Netlify (Site configuration → Environment variables).
# Nenhuma variável é obrigatória: sem elas o site roda completo, só sem envio de e-mails e sem análise.

# --- Endereço e indexação ---
NEXT_PUBLIC_SITE_URL=          # TODO: domínio final, ex.: https://www.dmconsultimoveis.com.br (no Netlify, vazio = endereço do Netlify)
NEXT_PUBLIC_INDEXAR=           # "true" só quando for o site oficial; vazio = fora do Google (versão de apresentação)

# --- Envio dos formulários (leads) ---
# E-mail via Resend (https://resend.com)
RESEND_API_KEY=
LEADS_EMAIL_PARA=          # TODO: e-mail que recebe os contatos (vários separados por vírgula)
LEADS_EMAIL_DE=            # ex.: Site DM <site@dmconsultimoveis.com.br> (domínio verificado no Resend)

# CRM / automação: recebe cada lead em JSON (opcional)
LEADS_WEBHOOK_URL=

# --- Google Maps ---
# Opcional. Sem chave, o mapa usa o embed público do Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Análise (só carregam após o visitante aceitar os cookies) ---
NEXT_PUBLIC_GA_ID=            # ex.: G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# --- Painel de conteúdo (Keystatic) em produção ---
# Sem estas variáveis o painel funciona só localmente (npm run dev → /keystatic);
# no site publicado ele aparece desativado, com uma explicação.
# Com elas, cada edição vira um commit no GitHub e o Netlify publica sozinho.
# Passo a passo: README → "Painel de conteúdo".
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=     # ex.: Gabronx/DM-IMOVEIS
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
